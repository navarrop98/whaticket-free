const getBodyButton = (message: proto.IWebMessageInfo): string => {
  if (message.message?.templateMessage?.hydratedFourRowTemplate) {
    return (
      message.message.templateMessage.hydratedFourRowTemplate.hydratedContentText ||
      ""
    );
  }
  if (message.message?.templateMessage?.hydratedTemplate) {
    return (
      message.message.templateMessage.hydratedTemplate.hydratedContentText ||
      ""
    );
  }
  return "";
};


const msgLocation = (message: proto.IWebMessageInfo): proto.Message.ILocationMessage | null => {
  return message.message?.locationMessage || null;
};

const getBodyMessage = (msg: proto.IWebMessageInfo): string => {
  const extract = extractMessageContent(msg.message);
  
  if (extract) {
    if (extract.conversation) {
      return extract.conversation;
    }
    if (extract.extendedTextMessage?.text) {
      return extract.extendedTextMessage.text;
    }
    if (extract.imageMessage?.caption) {
      return extract.imageMessage.caption;
    }
    if (extract.videoMessage?.caption) {
      return extract.videoMessage.caption;
    }
    if (extract.documentMessage?.caption) {
      return extract.documentMessage.caption;
    }
  }
  
  const bodyButton = getBodyButton(msg);
  if (bodyButton) return bodyButton;
  
  return "";
};
